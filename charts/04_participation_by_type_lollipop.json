{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart showing the proportion of Australians participating in selected nature-based recreational activities, 2011–2012.",
  "width": 370,
  "height": 360,
  "padding": {
    "top": 40,
    "left": 45,
    "bottom": 20
  },
  "data": {
    "url": "data/participation_by_type.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(replace(datum['Proportion (%)'], '%', ''))",
      "as": "ProportionValue"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "ProportionValue",
          "as": "MaxProportion"
        }
      ]
    },
    {
      "calculate": "format(datum.ProportionValue, '.1f') + '%'",
      "as": "Label"
    }
  ],
  "encoding": {
    "y": {
      "field": "Activity type",
      "type": "nominal",
      "sort": {
        "field": "ProportionValue",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelLimit": 200,
        "labelFontSize": 11.5,
        "labelLineHeight": 13,
        "labelExpr": "split(slice(replace(datum.label, regexp('(.{1,22})( |$)', 'g'), '$1|'), 0, -1), '|')"
      }
    },
    "x": {
      "field": "ProportionValue",
      "type": "quantitative",
      "scale": {
        "domain": [0, 55]
      },
      "axis": {
        "title": "Proportion (%)",
        "titleFontSize": 11.5,
        "grid": true,
        "tickCount": 6
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#A8B9AA",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "ProportionValue"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "color": "#21603c"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Activity type",
            "type": "nominal",
            "title": "Activity"
          },
          {
            "field": "ProportionValue",
            "type": "quantitative",
            "title": "Proportion (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.ProportionValue === datum.MaxProportion"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -1,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#21603c"
      },
      "encoding": {
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      }
    }
  ],
  "background": "transparent",
  "config": {
    "font": "Onest",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Onest",
      "titleFont": "Onest",
      "labelColor": "#26382D",
      "titleColor": "#26382D",
      "domainColor": "#A6B5A8",
      "tickColor": "#A6B5A8",
      "gridColor": "#E2E9E2"
    },
    "legend": {
      "labelFont": "Onest",
      "titleFont": "Onest"
    },
    "text": {
      "font": "Onest"
    }
  }
}